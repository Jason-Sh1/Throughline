# Copy to .env and fill in. Never commit .env.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: worker only, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string used by the worker (Settings > Database).
DATABASE_URL=

# --- LLMs (M3) ----------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Data sources (M2) --------------------------------------------------------
# Guardian Open Platform developer key (non-commercial use only).
GUARDIAN_API_KEY=
# Contact URL/email sent in the User-Agent so publishers can reach us.
CRAWLER_CONTACT=

# --- Clustering (M2) -----------------------------------------------------------
# Defaults live in worker/cluster/online.py; override here while tuning.
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CLUSTER_THRESHOLD=0.66
# CLUSTER_TIE_MARGIN=0.03
# CLUSTER_GRAY_MARGIN=0.05
# CLUSTER_MIN_ENTITY_OVERLAP=2
# CLUSTER_WINDOW_HOURS=72

# --- Monitoring (M8) ----------------------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
